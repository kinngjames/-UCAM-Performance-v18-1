# UCAM Performance · configuración local
#
# La baseline actual no necesita secretos en archivos .env.
# La base de datos se inyecta mediante el binding Cloudflare `DB` y la identidad
# ChatGPT/Sites mediante cabeceras de la plataforma.
#
# Overrides opcionales de las herramientas locales (descomentar solo si hace falta):
# SITES_INSTALL_TIMEOUT=180
# SITES_INSTALL_KILL_AFTER=15
# SITES_BUILD_TIMEOUT=180
# SITES_BUILD_KILL_AFTER=15
# WRANGLER_LOG_PATH=.wrangler/wrangler.log
#
# Futuro handoff a PostgreSQL/autenticación externa:
# documentar y añadir aquí únicamente los NOMBRES de las variables. Nunca valores reales.
# DATABASE_URL=
# AUTH_SECRET=
